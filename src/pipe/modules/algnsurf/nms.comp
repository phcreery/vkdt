#version 460
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_nonuniform_qualifier    : enable

#include "shared.glsl"
#include "surf.glsl"

layout(local_size_x = DT_LOCAL_SIZE_X, local_size_y = DT_LOCAL_SIZE_Y, local_size_z = 1) in;

layout(set = 1, binding = 0, std430) readonly buffer buf_hess { float hess[]; };
layout(set = 1, binding = 1, std430) buffer buf_cand { uint count; float data[]; };

float hess_at(int o, int i, int x, int y)
{
  const ivec4 sz = push.size[o];
  return hess[push.offset[o] + (i * sz.y + y) * sz.x + x];
}

// Find the local maxima of the hessian response in scale space.
// The z index of the invocation selects the octave and an inner interval.
// An invocation keeps its position only if the response is larger than the threshold.
// The response must be larger than the responses at all 26 neighbours.
// Then the invocation moves the position to the sub pixel maximum.
// It fits a quadratic function to the 3x3x3 neighbourhood.
// The invocation appends the result to the list of candidates.
void main()
{
  const ivec3 id = ivec3(gl_GlobalInvocationID);
  const int ninner = SURF_INTERVALS - 2;
  const int o = id.z / ninner;
  const int i = 1 + id.z % ninner;
  if(o >= SURF_OCTAVES) return;
  const ivec4 sz = push.size[o];
  const int x = id.x;
  const int y = id.y;
  if(x < 1 || y < 1 || x >= sz.x-1 || y >= sz.y-1) return;

  float v[27]; // index: (ds+1)*9 + (dy+1)*3 + (dx+1)
  for(int ds = -1; ds <= 1; ds++)
    for(int dy = -1; dy <= 1; dy++)
      for(int dx = -1; dx <= 1; dx++)
        v[(ds+1)*9 + (dy+1)*3 + dx+1] = hess_at(o, i+ds, x+dx, y+dy);
  const float val = v[13];
  if(!(val >= params.thresh)) return;
  for(int k = 0; k < 27; k++)
    if(k != 13 && !(val > v[k])) return;

  // Derivatives by finite differences. The order of the axes is x, y, scale.
  const float dxx = v[14] - 2.0*val + v[12];
  const float dyy = v[16] - 2.0*val + v[10];
  const float dss = v[22] - 2.0*val + v[ 4];
  const float dxy = 0.25 * (v[17] - v[15] - v[11] + v[ 9]);
  const float dxs = 0.25 * (v[23] - v[21] - v[ 5] + v[ 3]);
  const float dys = 0.25 * (v[25] - v[19] - v[ 7] + v[ 1]);
  const vec3  grad = 0.5 * vec3(v[14] - v[12], v[16] - v[10], v[22] - v[4]);
  const mat3  hm = mat3(dxx, dxy, dxs,  dxy, dyy, dys,  dxs, dys, dss);
  const vec3  off = -(inverse(hm) * grad);
  // This test also rejects a result that is not a number.
  if(!(abs(off.x) < 1.0 && abs(off.y) < 1.0 && abs(off.z) < 1.0)) return;

  float size;
  const float s0 = push.scale[o][i];
  if(off.z > 0.0) size = (1.0 - off.z) * s0 + off.z * push.scale[o][i+1];
  else            size = (1.0 + off.z) * s0 - off.z * push.scale[o][i-1];

  const uint slot = atomicAdd(count, 1u);
  if(slot >= CAND_MAX) return;
  const uint b = slot * KP_STRIDE;
  data[b + KP_X]      = (float(x) + off.x) * float(sz.w) + float(sz.z);
  data[b + KP_Y]      = (float(y) + off.y) * float(sz.w) + float(sz.z);
  data[b + KP_SIZE]   = size;
  data[b + KP_RESP]   = val;
  data[b + KP_ANGLE]  = 0.0;
  data[b + KP_OCTAVE] = float(o);
  data[b + KP_LAP]    = (floatBitsToUint(val) & 1u) != 0u ? 1.0 : -1.0;
  data[b + 7]         = 0.0;
}
