#version 460
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_nonuniform_qualifier    : enable

#include "shared.glsl"

layout(local_size_x = DT_LOCAL_SIZE_X, local_size_y = DT_LOCAL_SIZE_Y, local_size_z = 1) in;

layout(push_constant, std140) uniform push_t
{
  ivec2 dst; // size of the reference image
  ivec2 src; // size of the image that the module aligns
} push;

layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1) uniform writeonly image2D img_out;
layout(set = 1, binding = 2, std430) readonly buffer buf_h { uint valid; uint inliers; uint matches; uint pad; float h[9]; };

// Warp the input image to the reference image.
// The matrix maps pixel coordinates of the reference image to pixel coordinates of the aligned image.
// The coordinates are the positions of the pixel corners.
// This means that the centre of the first pixel is at (0.5, 0.5).
// The input image can have a different size than the two images of the matrix.
// Therefore the shader uses coordinates relative to the image size.
// The shader writes black where the input image has no data.
// If the solver found no valid matrix, the shader copies the input image.
void main()
{
  const ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size = imageSize(img_out);
  if(dst.x >= size.x || dst.y >= size.y) return;

  // Without a valid matrix, the matrix maps the reference image to the same relative position.
  const vec2 ratio = vec2(push.src) / vec2(push.dst);
  mat3 hm = mat3(ratio.x, 0.0, 0.0,  0.0, ratio.y, 0.0,  0.0, 0.0, 1.0);
  if(valid != 0u)
    hm = mat3(h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]);

  const vec2 p = (vec2(dst) + 0.5) / vec2(size) * vec2(push.dst);
  const vec3 q = hm * vec3(p, 1.0);
  const vec2 uv = q.xy / q.z / vec2(push.src);
  vec4 rgba = vec4(0.0);
  if(q.z > 0.0 && all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0))))
    rgba = texture(img_in, uv);
  imageStore(img_out, dst, rgba);
}
